{
  "name": "@pmk/rag",
  "version": "0.15.0",
  "description": "RAG engine for pmk — pure-JS TF-IDF retrieval over pm-workspace-kit docs (no native deps)",
  "license": "MIT",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck:test && node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@pmk/core": "*",
    "@pmk/shared": "*",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=20.0"
  }
}
