{
  "display_information": {
    "name": "pmk",
    "description": "PM Workspace Kit — knowledge-loop gateway for code-aware teams",
    "background_color": "#1f2937"
  },
  "features": {
    "bot_user": {
      "display_name": "pmk",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "im:history",
        "im:read",
        "im:write",
        "users:read",
        "reactions:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.im",
        "app_mention",
        "reaction_added"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
