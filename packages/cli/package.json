{
  "name": "@pmk/cli",
  "version": "0.27.0",
  "description": "pmk — command-line interface for pm-workspace-kit",
  "license": "MIT",
  "bin": {
    "pmk": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "default": "./dist/llm/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/gateway/slack/manifest.template.json dist/gateway/slack/manifest.template.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck:test && node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.165",
    "@anthropic-ai/sdk": "^0.100.0",
    "@clack/prompts": "^0.7.0",
    "@pmk/core": "*",
    "@pmk/rag": "*",
    "@pmk/shared": "*",
    "@slack/socket-mode": "^2.0.6",
    "@slack/web-api": "^7.15.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "gray-matter": "^4.0.3",
    "unpdf": "1.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=20.0"
  }
}
